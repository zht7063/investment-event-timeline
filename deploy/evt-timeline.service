[Unit]
Description=Investment Event Timeline (Next.js)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
ExecStart=@NODE_BIN@ node_modules/next/dist/bin/next start --hostname @BIND_HOST@ --port @PORT@
Environment=NODE_ENV=production
UMask=0077
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=evt-timeline

NoNewPrivileges=true

[Install]
WantedBy=default.target
