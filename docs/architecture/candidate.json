  "cards": [
    {
      "dot": "cyan",
      "title": "两条证据链",
      "items": [
        "人工链：导入或同步 → 摘录校验 → 人工确认 → 规则结论。",
        "自动链：SQLite 任务 → worker → 区间报告与统一事件库；未经人工确认。"
      ]
    },
    {
      "dot": "emerald",
      "title": "进程与持久化",
      "items": [
        "Compose 运行 web、sync、research 三个进程，共享 app-data 卷。",
        "队列即 research_jobs 表；无独立消息服务。取消或删除使租约失效。"
      ]
    },
    {
      "dot": "amber",
      "title": "边界",
      "items": [
        "外部接口节点合并展示数据供应商与模型，正文仅为片段或摘要。",
        "模型建议经程序校验；结论状态由领域规则计算。管理口令只保护指定操作。"
      ]
    }
  ]
