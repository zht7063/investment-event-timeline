# 环境变量模板：复制为 .env 后填写（cp .local.env .env）。本文件只放占位符，不要写入真实密钥。
# 等号后不要加引号和空格。必填项缺失时，对应功能显示“未配置”，不会用假数据冒充。

# ---------- 应用 ----------
# SQLite 数据库文件路径
DATABASE_PATH=./data/app.db
# 同步数据源、重置演示数据所需的管理口令（必填），例如 openssl rand -hex 24 生成
ADMIN_TOKEN=
# 对外访问地址，例如 https://events.example.com；本地留空
APP_PUBLIC_URL=

# ---------- 模型（必填，OpenAI 兼容接口） ----------
# 接口地址，需包含 /v1
AI_BASE_URL=
# 模型名称，需支持 JSON 结构化输出
AI_MODEL=
AI_API_KEY=

# ---------- 扶摇金融数据 ----------
# 文档 https://fuyao.aicubes.cn/docs/mcp/overview/ ；Key 在 https://fuyao.aicubes.cn/admin/ 签发
# MCP 与 REST 共用同一个 Key，请求头 X-api-key
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn
# meta：标的检索 get_meta_tickers_search（参数 q）
FUYAO_MCP_META_URL=https://fuyao.aicubes.cn/mcp/meta
# news：2026-10-25 实测 MCP 端点 POST 返回 405，改用 REST
# GET {FUYAO_BASE_URL}/api/news/stock/timeline-list?thscode=600519.SH&offset=first
FUYAO_MCP_NEWS_URL=https://fuyao.aicubes.cn/mcp/news
# a-share：行情快照 get_a_share_prices_snapshot（参数 thscodes），仅作标的背景
FUYAO_MCP_A_SHARE_URL=https://fuyao.aicubes.cn/mcp/a-share

# ---------- iFinD MCP ----------
# 登录 https://mcp.51ifind.com ，个人中心 -> 密钥 获取 MCP 密钥
# 地址取自官方 SKILL 包 ifind-finance-data-1.5.0；streamable HTTP，请求头 Authorization: <密钥>
# news：search_news / search_notice / search_trending_news，必填 query、size(<=20)、time_start、time_end
IFIND_MCP_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-news-mcp
# stock：A 股公司资料、行情、事件（get_stock_events 等）
IFIND_MCP_STOCK_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-stock-mcp
IFIND_TOKEN=
